generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  USER
  ADMIN
}

enum TitleType {
  show
  movie
  anime
}

enum ActionType {
  pass
  like
  super_like
  watched
}

enum ReportStatus {
  PENDING
  REVIEWED
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  role         Role      @default(USER)
  bannedAt     DateTime?
  // Bumped by admin "kick" — embedded in the JWT at login and checked on every authenticated
  // request; a mismatch means the token predates the kick, forcing re-login without banning.
  tokenVersion Int       @default(0)

  // Social & Taste Twins — nullable: existing accounts have no username until they set one,
  // and social features (search, twins, chat, friends) require it first. No fabricated default.
  username     String? @unique
  avatarUrl    String?
  discoverable Boolean @default(true)

  actions         UserTitleAction[]
  ratings         Rating[]
  quizResponses   QuizResponse[]
  reportsFiled    Report[]          @relation("ReporterRel")
  reportsReceived Report[]          @relation("ReportedRel")
  blocksMade      Block[]           @relation("BlockerRel")
  blocksReceived  Block[]           @relation("BlockedRel")

  friendRequestsSent     Friendship[]           @relation("FriendRequester")
  friendRequestsReceived Friendship[]           @relation("FriendAddressee")
  messagesSent           Message[]              @relation("MessageSender")
  messagesReceived       Message[]              @relation("MessageRecipient")
  watchTogetherInitiated WatchTogetherSession[] @relation("WTInitiator")
  watchTogetherJoined    WatchTogetherSession[] @relation("WTPartner")
  passwordResetTokens    PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  // SHA-256 hash of the raw token — the raw token only ever exists in the emailed link, never
  // stored, so a DB leak alone can't be used to reset anyone's password.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Friendship {
  id          String           @id @default(uuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  requester User @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
}

model Message {
  id            String    @id @default(uuid())
  senderId      String
  recipientId   String
  content       String
  sharedTitleId String?
  createdAt     DateTime  @default(now())
  readAt        DateTime?

  sender      User   @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User   @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  sharedTitle Title? @relation(fields: [sharedTitleId], references: [id], onDelete: SetNull)

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, readAt])
}

model WatchTogetherSession {
  id            String   @id @default(uuid())
  initiatorId   String
  partnerId     String
  mergedProfile String // JSON-encoded TagProfile, same encoding convention as QuizResponse
  createdAt     DateTime @default(now())

  initiator User              @relation("WTInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  partner   User              @relation("WTPartner", fields: [partnerId], references: [id], onDelete: Cascade)
  actions   UserTitleAction[]
}

model Report {
  id             String       @id @default(uuid())
  reporterId     String
  reportedUserId String
  reason         String
  status         ReportStatus @default(PENDING)
  createdAt      DateTime     @default(now())
  reviewedAt     DateTime?

  reporter     User @relation("ReporterRel", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User @relation("ReportedRel", fields: [reportedUserId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlockerRel", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockedRel", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model Title {
  id             String    @id @default(uuid())
  name           String
  type           TitleType
  plotSummary    String
  cast           String // JSON-encoded string[] (SQLite has no native array type)
  seasons        Int?
  episodes       Int?
  runtimeMinutes Int?
  releaseYear    Int
  platforms      String // JSON-encoded string[]
  languages      String    @default("[\"English\"]") // JSON-encoded string[] — hard filter, see buildDeck
  posterUrl      String
  tags           String // JSON-encoded TitleTags object (includes industry)
  dateAdded      DateTime  @default(now())
  // Kept alongside the actors/title_actors join (not replaced by it) for backward
  // compatibility with the existing flat cast-name search in Browse & Search — new/backfilled
  // titles populate both, per the actor/director finder spec.
  directors      String    @default("[]") // JSON-encoded string[], mirrors cast

  actions          UserTitleAction[]
  ratings          Rating[]
  sharedInMessages Message[]
  titleActors      TitleActor[]
  titleDirectors   TitleDirector[]

  @@index([type])
}

model Actor {
  id       String  @id @default(uuid())
  name     String
  photoUrl String? // null until resolved via the Image Sourcing Pipeline — see needs-manual-photo.json
  industry String // JSON-encoded string[] — same vocabulary as Title.tags.industry
  bio      String?

  createdAt DateTime @default(now())

  titles TitleActor[]

  @@index([name])
}

model TitleActor {
  id      String @id @default(uuid())
  titleId String
  actorId String

  title Title @relation(fields: [titleId], references: [id], onDelete: Cascade)
  actor Actor @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@unique([titleId, actorId])
  @@index([actorId])
}

model Director {
  id       String  @id @default(uuid())
  name     String
  photoUrl String? // null until resolved — see needs-manual-photo.json
  industry String // JSON-encoded string[]
  // Computed field — top 2-3 genres by frequency across this director's linked titles, ties
  // broken by whichever genre appears in their highest-rated title. Recomputed on-write
  // whenever a new TitleDirector row links to this director (see lib/directors.ts), never a
  // batch job — write volume here is low.
  knownForStyles String @default("[]") // JSON-encoded string[]
  bio            String?

  createdAt DateTime @default(now())

  titles TitleDirector[]

  @@index([name])
}

model TitleDirector {
  id         String @id @default(uuid())
  titleId    String
  directorId String

  title    Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)
  director Director @relation(fields: [directorId], references: [id], onDelete: Cascade)

  @@unique([titleId, directorId])
  @@index([directorId])
}

model UserTitleAction {
  id                     String     @id @default(uuid())
  userId                 String
  titleId                String
  action                 ActionType
  createdAt              DateTime   @default(now())
  // set when this swipe happened inside a Watch Together session — the joint watchlist is
  // just actions filtered by this id, reusing the existing action-recording pipeline instead
  // of a parallel table.
  watchTogetherSessionId String?

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                Title                 @relation(fields: [titleId], references: [id], onDelete: Cascade)
  watchTogetherSession WatchTogetherSession? @relation(fields: [watchTogetherSessionId], references: [id], onDelete: Cascade)

  @@index([userId, action])
  @@index([titleId])
  @@index([watchTogetherSessionId])
}

model Rating {
  id        String   @id @default(uuid())
  userId    String
  titleId   String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title Title @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@unique([userId, titleId])
  @@index([titleId])
}

model QuizResponse {
  id                  String   @id @default(uuid())
  userId              String
  kind                String // "onboarding" | "next_show"
  answers             String // JSON-encoded question_id -> answer
  resultingTagProfile String // JSON-encoded tag -> weight
  watchedTitleId      String? // set for next_show responses
  createdAt           DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
}
